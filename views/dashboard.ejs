<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Smart Will & Legacy</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap');
        
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            color: #fff;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            height: 100vh;
        }
        .navbar {
            width: 100%;
            background: rgba(255, 255, 255, 0.1);
            padding: 15px 30px;
            text-align: center;
            font-size: 1.5em;
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
        }
        .dashboard-container {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 25px;
            margin-top: 50px;
        }
        .card {
            background: rgba(255, 255, 255, 0.2);
            padding: 20px;
            border-radius: 15px;
            text-align: center;
            width: 250px;
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
            cursor: pointer;
            backdrop-filter: blur(15px);
        }
        .card:hover {
            transform: scale(1.1);
        }
        .card-title {
            font-size: 1.3em;
            font-weight: bold;
        }
        .scales-container {
            position: absolute;
            bottom: 20px;
            right: 20px;
            width: 150px;
        }
        .scales-container svg {
            animation: swing 2s infinite alternate ease-in-out;
        }
        @keyframes swing {
            0% { transform: rotate(-5deg); }
            100% { transform: rotate(5deg); }
        }
    </style>
</head>
<body>
    <div class="navbar">Smart Will & Legacy Dashboard</div>
    <div class="dashboard-container">
        <a href="/create-will"><div class="card"> <div class="card-title">Create Will</a></div> </div>
        </a><div class="card"> <div class="card-title"><a href="/edit-will">Manage Beneficiaries</a></div> </div>
        </a><div class="card"> <div class="card-title"><a href="/view-will">Legal Documents</a></div> </div>
        <div class="card"> <div class="card-title">Settings</div> </div>
    </div>
    <div class="scales-container">
        <svg width="150" height="120" viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" fill="white">
            <line x1="100" y1="10" x2="100" y2="60" stroke="white" stroke-width="5"/>
            <line x1="50" y1="60" x2="150" y2="60" stroke="white" stroke-width="5"/>
            <line x1="50" y1="60" x2="30" y2="110" stroke="white" stroke-width="5"/>
            <line x1="150" y1="60" x2="170" y2="110" stroke="white" stroke-width="5"/>
            <circle cx="100" cy="60" r="6" fill="white"/>
            <ellipse cx="30" cy="120" rx="25" ry="12" fill="white"/>
            <ellipse cx="170" cy="120" rx="25" ry="12" fill="white"/>
        </svg>
    </div>
</body>
</html>
